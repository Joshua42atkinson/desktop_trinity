# Environment Configuration Template
# Copy this to .env and customize for your system

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=vibe_coding_memory

# Database Configuration
# DATABASE_URL=postgres://user:password@localhost:5432/daydream_db

# Model Configuration
# Autocomplete (fast, ~6-7B parameters for low latency)
MODEL_AUTOCOMPLETE=deepseek-coder:6.7b-instruct

# Chat (balanced, ~8B for everyday use)
MODEL_CHAT=llama3.1:8b

# Code generation (specialized for code)
MODEL_CODE=codellama:13b

# Advanced reasoning (requires VGM allocation in BIOS)
MODEL_ADVANCED=llama3.1:70b

# ROCm Configuration (adjust based on your hardware)
# For Radeon 8060S (RDNA 3.5 / gfx1103)
HSA_OVERRIDE_GFX_VERSION=11.0.3
GPU_DEVICE_ORDINAL=0

# Agent Configuration
AGENT_VERBOSE=true
AGENT_MAX_ITERATIONS=10

# Optional: Hugging Face token for downloading models
# HF_TOKEN=your_token_here
